// Выполняет команды в пакетном режиме.
// Допустимые параметр пакетного режима:
//  /CРежимЗапуска=ВыгрузитьДанные;ФайлНастроек=С:\Temp\НастройкиВыгрузки.json;Файл=С:\Temp\Выгрузка.json
//  /CРежимЗапуска=ЗагрузитьДанные;Файл=С:\Temp\Выгрузка.json
//
&НаКлиенте
Асинх Процедура ВыполнитьКомандуПакетногоРежима()
	
	Если Не ЗначениеЗаполнено(ПараметрЗапуска) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗапускаПомощника = ИнициализироватьПараметрыЗапускаПомощника(ПараметрЗапуска);
	ШаблонСообщенияОтсутствуетФайл         = НСтр("ru = 'Файл %1 не существует'");
	ШаблонСообщенияНеизвестныйРежимЗапуска = НСтр("ru = 'В параметрах запуска установлен не известный режим: РежимЗапуска=%1'");
	
	Если НЕ ЗначениеЗаполнено(ПараметрыЗапускаПомощника.РежимЗапуска) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыЗапускаПомощника.РежимЗапуска = "ЗагрузитьДанные" И ЗначениеЗаполнено(ПараметрыЗапускаПомощника.Файл) Тогда
		Файл = Новый Файл(ПараметрыЗапускаПомощника.Файл);
		Если Не Файл.Существует() Тогда
			ВызватьИсключение СтрШаблон(ШаблонСообщенияОтсутствуетФайл, ПараметрыЗапускаПомощника.Файл);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыЗапускаПомощника.ФайлНастроек) Тогда
		Файл = Новый Файл(ПараметрыЗапускаПомощника.ФайлНастроек);
		Если Не Файл.Существует() Тогда
			ВызватьИсключение СтрШаблон(ШаблонСообщенияОтсутствуетФайл, ПараметрыЗапускаПомощника.ФайлНастроек);
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыЗапускаПомощника.РежимЗапуска = "ВыгрузитьДанные"
		И ЗначениеЗаполнено(ПараметрыЗапускаПомощника.ФайлНастроек)
		И ЗначениеЗаполнено(ПараметрыЗапускаПомощника.Файл) Тогда
		ЗагрузитьФайлНастройкиВыгрузки(ПараметрыЗапускаПомощника.ФайлНастроек);
		ВыгрузитьДанныеОбъектов(ПараметрыЗапускаПомощника.Файл);
	ИначеЕсли ПараметрыЗапускаПомощника.РежимЗапуска = "ЗагрузитьДанные" И ЗначениеЗаполнено(ПараметрыЗапускаПомощника.Файл) Тогда
		ОжиданиеОписания = ПоместитьФайлНаСерверАсинх(Неопределено, Неопределено, "", ПараметрыЗапускаПомощника.Файл, УникальныйИдентификатор);
		ОписаниеПомещенногоФайла = Ждать ОжиданиеОписания;
		Если Не ОписаниеПомещенногоФайла = Неопределено Тогда
			ЗагрузитьДанныеОбъектовИзФайла(ОписаниеПомещенногоФайла);
		КонецЕсли;
	Иначе
		ВызватьИсключение СтрШаблон(ШаблонСообщенияНеизвестныйРежимЗапуска, ПараметрыЗапускаПомощника.РежимЗапуска);
	КонецЕсли;
	
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

&НаКлиенте
Функция ИнициализироватьПараметрыЗапускаПомощника(Знач ПараметрыЗапускаПомощникаСтрокой)
	
	ПараметрыЗапускаПомощника = Новый Структура;
	ПараметрыЗапускаПомощника.Вставить("РежимЗапуска",         "");
	ПараметрыЗапускаПомощника.Вставить("ФайлНастроек",         "");
	ПараметрыЗапускаПомощника.Вставить("Файл",                 "");
	
	КлючиЗапуска = СтрРазделить(Сред(ПараметрыЗапускаПомощникаСтрокой, 3), ";");
	
	Для Каждого КлючЗапуска Из КлючиЗапуска Цикл
		КлючИЗначение = СтрРазделить(КлючЗапуска, "=");
		Если КлючИЗначение.Количество() <> 2 Тогда
			Продолжить;
		КонецЕсли;
		Если ПараметрыЗапускаПомощника.Свойство(КлючИЗначение[0]) Тогда
			ПараметрыЗапускаПомощника.Вставить(КлючИЗначение[0], КлючИЗначение[1]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПараметрыЗапускаПомощника;
	
КонецФункции

