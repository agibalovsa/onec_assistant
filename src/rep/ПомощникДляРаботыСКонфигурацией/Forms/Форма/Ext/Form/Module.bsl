&НаКлиенте
Процедура ВыполнитьОчисткуОбъектаЗадатьВопрос()
	
	ТекущиеДанные = Элементы.ОбъектыМетаданных.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Пропустить = НЕ ТекущиеДанные.Раздел = "Измерения"
		И НЕ (
			ТекущиеДанные.Имя = "Измерения"
			И НЕ ТекущиеДанные.ЭтоПоле
		)
		И Не ТекущиеДанные.ЭтоОсновнаяТаблица;
	
	Если Пропустить Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Если ТекущиеДанные.Раздел = "Измерения" И ТекущиеДанные.ЭтоПоле Тогда
		Отбор.Вставить(ТекущиеДанные.Имя);
		ТекущиеДанные = ТекущиеДанные.ПолучитьРодителя().ПолучитьРодителя();
	ИначеЕсли ТекущиеДанные.Имя = "Измерения" И НЕ ТекущиеДанные.ЭтоПоле Тогда
		Отбор.Вставить("Все", "*");
		ТекущиеДанные = ТекущиеДанные.ПолучитьРодителя();
	КонецЕсли;
	
	ЭлементОбъектовМетаданных = Новый Структура;
	ЭлементОбъектовМетаданных.Вставить("ПолноеИмя",         ТекущиеДанные.ПолноеИмя);
	ЭлементОбъектовМетаданных.Вставить("Раздел",            ТекущиеДанные.Раздел);
	ЭлементОбъектовМетаданных.Вставить("ПараметрыВыгрузки", Неопределено);
	ЭлементОбъектовМетаданных.Вставить("Отбор",             Отбор);
	
	ВыполнитьОчисткуОбъекта = Новый ОписаниеОповещения("ВыполнитьОчисткуОбъектаЗадатьВопросЗавершение", ЭтотОбъект, ЭлементОбъектовМетаданных);
	ПоказатьВопрос(ВыполнитьОчисткуОбъекта, НСтр("ru = 'Внимание, после подтверждения у объекта будут очищены все записи. Продолжить'"), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#КонецОбласти

#Область Частные

&НаКлиенте
Процедура ВыполнитьОчисткуОбъектаЗадатьВопросЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыполнитьОчисткуОбъектаПовторитьВопрос(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОчисткуОбъектаПовторитьВопрос(ЭлементОбъектовМетаданных)
	
	ВыполнитьОчисткуОбъекта = Новый ОписаниеОповещения("ВыполнитьОчисткуОбъектаПовторитьВопросЗавершение", ЭтотОбъект, ЭлементОбъектовМетаданных);
	ПоказатьВопрос(ВыполнитьОчисткуОбъекта, НСтр("ru = 'Внимание, после очистки данные нельзя будет восстановить. Продолжить'"), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОчисткуОбъектаПовторитьВопросЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		РаботаСМетаданными.ВыполнитьОчисткуОбъекта(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

