Процедура ЗагрузитьДанныеЗавершение(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
	
	Если ОписаниеПомещенногоФайла = Неопределено Тогда
		СообщитьПользователю(НСтр("ru = 'Ошибка загрузки файла выгрузки'"));
		Возврат;
	КонецЕсли;
	
	ДатаНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЗагрузитьДанныеОбъектовИзФайла(ОписаниеПомещенногоФайла, ДополнительныеПараметры.ПараметрыВыгрузки);
	
	ДатаОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДлительностьОперации = (ДатаОкончания - ДатаНачала)/1000;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеОбъектовИзФайла(ОписаниеПомещенногоФайла, ПараметрыВыгрузки = Неопределено)
	
	Расширение = НРег(СтрЗаменить(ОписаниеПомещенногоФайла.СсылкаНаФайл.Расширение, ".", ""));
	Если ПараметрыВыгрузки = Неопределено Тогда
		ПараметрыВыгрузки = ИнициализироватьПараметрыВыгрузки(Ложь);
	КонецЕсли;
	ПараметрыВыгрузки.СтрогийФорматВыгрузки = (Расширение = "xml");
	
	ДанныеЗагрузки = РаботаСМетаданными.ЗагрузитьДанныеОбъектов(ОписаниеПомещенногоФайла.Адрес, ПараметрыВыгрузки);
	ВывестиПротокол(ДанныеЗагрузки.Протокол);
	
КонецПроцедуры

#Если НЕ ВебКлиент Тогда

&НаКлиенте
Процедура СохранитьНастройкиВыгрузкиОкончаниеВыбора(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьJSON = ИнициализироватьВыгрузкуJSON(ВыбранныеФайлы[0]);
	СформироватьФайлНастроекВыгрузкиJSON(ЗаписьJSON);
	СообщитьПользователю(НСтр("ru = 'Настройки сохранены'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлЗагрузкиНастроекВыгрузкиОкончаниеВыбора(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбранныеФайлы) Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьФайлНастройкиВыгрузки(ВыбранныеФайлы[0]);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФайлНастройкиВыгрузки(ФайлНастроек)
	
	Если ОбъектыМетаданных.ПолучитьЭлементы().Количество() = 0 Тогда
		ЗаполнитьМетаданныеСобытие();
	КонецЕсли;
	
	ЧтениеJSON = ИнициализироватьЗагрузкуJSON(ФайлНастроек);
	ПрименитьФайлНастроекJSON(ЧтениеJSON);
	СообщитьПользователю(НСтр("ru = 'Настройки прочитаны'"));
	
КонецПроцедуры

&НаКлиенте
Функция ИнициализироватьВыгрузкуJSON(ИмяФайлаВыгрузки)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON(, Символы.Таб);
	ЗаписьJSON.ОткрытьФайл(ИмяФайлаВыгрузки,,, ПараметрыЗаписиJSON);
	
	Возврат ЗаписьJSON;
	
КонецФункции

&НаКлиенте
Функция ИнициализироватьЗагрузкуJSON(ИмяФайлаЗагрузки)
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.ОткрытьФайл(ИмяФайлаЗагрузки);
	
	Возврат ЧтениеJSON;
	
КонецФункции

&НаКлиенте
Процедура СформироватьФайлНастроекВыгрузкиJSON(ЗаписьJSON, ДанныеВыгрузки = Неопределено, Уровень = 0)
	
	Уровень = Уровень + 1;
	
	Если Уровень = 1 Тогда
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("РежимВыгрузкиПоСсылке");
		ЗаписьJSON.ЗаписатьЗначение(Элементы.ОбъектыМетаданныхРежимВыгрузкиПоСсылке.Пометка);
		ЗаписьJSON.ЗаписатьИмяСвойства("ОчищатьНеВыгружаемыеСсылки");
		ЗаписьJSON.ЗаписатьЗначение(Элементы.ОбъектыМетаданныхОчищатьНеВыгружаемыеСсылки.Пометка);
		ЗаписьJSON.ЗаписатьИмяСвойства("СтрогийФорматВыгрузки");
		ЗаписьJSON.ЗаписатьЗначение(Элементы.ОбъектыМетаданныхСтрогийФорматВыгрузки.Пометка);
		ЗаписьJSON.ЗаписатьИмяСвойства("ВыгружатьПомеченныеНаУдаление");
		ЗаписьJSON.ЗаписатьЗначение(Элементы.ОбъектыМетаданныхВыгружатьПомеченныеНаУдаление.Пометка);
		ЗаписьJSON.ЗаписатьИмяСвойства("ОчищатьНеСовпадающиеЭлементыПриЗагрузке");
		ЗаписьJSON.ЗаписатьЗначение(Элементы.ОбъектыМетаданныхОчищатьНеСовпадающиеЭлементыПриЗагрузке.Пометка);
		ЗаписьJSON.ЗаписатьИмяСвойства("Строки");
		ЗаписьJSON.ЗаписатьНачалоМассива();
	КонецЕсли;
	
	Если ДанныеВыгрузки = Неопределено Тогда
		ДанныеВыгрузки = ОбъектыМетаданных;
	КонецЕсли;
	
	ЭлементыВыгрузки = ДанныеВыгрузки.ПолучитьЭлементы();
	
	Для Каждого ЭлементВыгрузки Из ЭлементыВыгрузки Цикл
		
		Если Не ЭлементВыгрузки.ЭтоОсновнаяТаблица Тогда
			СформироватьФайлНастроекВыгрузкиJSON(ЗаписьJSON, ЭлементВыгрузки, Уровень);
		КонецЕсли;
		
		Если ЭлементВыгрузки.ЭтоОсновнаяТаблица И ЭлементВыгрузки.Выгружать Тогда
			ЗаписатьСтрокуФайлаНастроекJSON(ЗаписьJSON, ЭлементВыгрузки.ПолноеИмя, ЭлементВыгрузки.ПараметрыВыгрузки, ЭлементВыгрузки.Выгружать, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Уровень = 1 Тогда
		ЗаписьJSON.ЗаписатьКонецМассива();
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		ЗаписьJSON.Закрыть();
	КонецЕсли;
	
	Уровень = Уровень - 1;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФайлНастроекJSON(ЧтениеJSON)
	
	ДанныеJSON = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Если ДанныеJSON.Свойство("РежимВыгрузкиПоСсылке") Тогда
		Элементы.ОбъектыМетаданныхРежимВыгрузкиПоСсылке.Пометка = ДанныеJSON.РежимВыгрузкиПоСсылке;
	КонецЕсли;
	
	Если ДанныеJSON.Свойство("ОчищатьНеВыгружаемыеСсылки") Тогда
		Элементы.ОбъектыМетаданныхОчищатьНеВыгружаемыеСсылки.Пометка = ДанныеJSON.ОчищатьНеВыгружаемыеСсылки;
	КонецЕсли;
	
	Если ДанныеJSON.Свойство("СтрогийФорматВыгрузки") Тогда
		Элементы.ОбъектыМетаданныхСтрогийФорматВыгрузки.Пометка = ДанныеJSON.СтрогийФорматВыгрузки;
	КонецЕсли;
	
	Если ДанныеJSON.Свойство("ВыгружатьПомеченныеНаУдаление") Тогда
		Элементы.ОбъектыМетаданныхВыгружатьПомеченныеНаУдаление.Пометка = ДанныеJSON.ВыгружатьПомеченныеНаУдаление;
	КонецЕсли;
	
	Если ДанныеJSON.Свойство("ОчищатьНеСовпадающиеЭлементыПриЗагрузке") Тогда
		Элементы.ОбъектыМетаданныхОчищатьНеСовпадающиеЭлементыПриЗагрузке.Пометка = ДанныеJSON.ОчищатьНеСовпадающиеЭлементыПриЗагрузке;
	КонецЕсли;
	
	ДанныеНастроек = Новый Соответствие();
	Для Каждого Строка Из ДанныеJSON.Строки Цикл
		ДанныеНастроек.Вставить(Строка.ПолноеИмя, Строка);
	КонецЦикла;
	
	ПрименитьДанныеНастроек(ДанныеНастроек);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьДанныеНастроек(ДанныеНастроек, ДанныеВыгрузки = Неопределено)
	
	Если ДанныеВыгрузки = Неопределено Тогда
		ДанныеВыгрузки = ОбъектыМетаданных;
	КонецЕсли;
	
	ЭлементыВыгрузки = ДанныеВыгрузки.ПолучитьЭлементы();
	
	Для Каждого ЭлементВыгрузки Из ЭлементыВыгрузки Цикл
		
		Если Не ЭлементВыгрузки.ЭтоОсновнаяТаблица Тогда
			ПрименитьДанныеНастроек(ДанныеНастроек, ЭлементВыгрузки);
		КонецЕсли;
		
		НастройкаВыгрузки = ДанныеНастроек.Получить(ЭлементВыгрузки.ПолноеИмя);
		
		Если ЭлементВыгрузки.ЭтоОсновнаяТаблица
			И ЗначениеЗаполнено(НастройкаВыгрузки) Тогда
			ЭлементВыгрузки.Выгружать = НастройкаВыгрузки.Выгружать;
			Если ЭлементВыгрузки.Выгружать Тогда
				РаботаСМетаданными.ПроставитьСтатусЭлемента(ЭлементВыгрузки, "Выгружать");
			КонецЕсли;
			Если НастройкаВыгрузки.Свойство("ПараметрыВыгрузки") Тогда
				ЭлементВыгрузки.ПараметрыВыгрузки = НастройкаВыгрузки.ПараметрыВыгрузки;
				ЭлементВыгрузки.КартинкаПараметрыВыгрузки = БиблиотекаКартинок.ПараметрыВыводаКомпоновкиДанных;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСтрокуФайлаНастроекJSON(ЗаписьJSON, ПолноеИмя, ПараметрыВыгрузки, Выгружать, ВыгружатьПриНеобходимости)
	
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("ПолноеИмя");
	ЗаписьJSON.ЗаписатьЗначение(ПолноеИмя);
	ЗаписьJSON.ЗаписатьИмяСвойства("Выгружать");
	ЗаписьJSON.ЗаписатьЗначение(Выгружать);
	ЗаписьJSON.ЗаписатьИмяСвойства("ВыгружатьПриНеобходимости");
	ЗаписьJSON.ЗаписатьЗначение(ВыгружатьПриНеобходимости);
	ЗаписьJSON.ЗаписатьИмяСвойства("ПолноеИмя");
	ЗаписьJSON.ЗаписатьЗначение(ПолноеИмя);
	Если ЗначениеЗаполнено(ПараметрыВыгрузки) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("ПараметрыВыгрузки");
		ЗаписьJSON.ЗаписатьЗначение(ПараметрыВыгрузки);
	КонецЕсли;
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	
КонецПроцедуры

#КонецЕсли

#КонецОбласти

#КонецОбласти

