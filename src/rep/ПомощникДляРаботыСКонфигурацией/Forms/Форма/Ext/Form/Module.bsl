&НаКлиенте
Процедура НайтиБитыеСсылкиПоТекущемуОбъекту()
	
	ТекущиеДанные = Элементы.ОбъектыМетаданных.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	
	Если ТекущиеДанные.ЭтоОсновнаяТаблица Тогда
		Отбор.Вставить("ИмяТаблицы", ТекущиеДанные.ПолноеИмя);
	ИначеЕсли ТекущиеДанные.ЭтоПоле Тогда 
		Отбор.Вставить("ИмяТаблицы", ТекущиеДанные.Владелец);
		Отбор.Вставить("ИмяПоля",    ТекущиеДанные.Имя);
	Иначе
		Отбор.Вставить("Раздел", ТекущиеДанные.Имя);
	КонецЕсли;
	
	РаботаСМетаданными.НайтиБитыеСсылки(ЭтотОбъект, Отбор);
	
КонецПроцедуры

