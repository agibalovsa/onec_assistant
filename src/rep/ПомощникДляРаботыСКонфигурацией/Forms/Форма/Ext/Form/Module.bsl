#Область Частные

// Добавить текст сообщения в протокол.
// 
// Параметры:
//  Сообщение - Структура Из КлючИЗначение
//  Важность - Число - Важность сообщения: 0 - информация, 1 - предупреждение, 2 - ошибка
//  Группа - Строка - Группировка протокола
//         - ЛюбаяСсылка
//
&НаКлиенте
Процедура ДобавитьТекстСообщения(Сообщение) Экспорт
	
	ГруппаПротокола = ПолучитьГруппуПротокола(Сообщение.Группа);
	СтрокаПротокола = ГруппаПротокола.Добавить();
	Если Сообщение.Важность = 1 Тогда
		СтрокаПротокола.Важность = БиблиотекаКартинок.ДиалогВосклицание;
	ИначеЕсли Сообщение.Важность = 2 Тогда
		СтрокаПротокола.Важность = БиблиотекаКартинок.ДиалогСтоп;
	Иначе
		СтрокаПротокола.Важность = БиблиотекаКартинок.ДиалогИнформация;
	КонецЕсли;
	СтрокаПротокола.Текст            = Сообщение.Текст;
	СтрокаПротокола.Уровень          = 1;
	СтрокаПротокола.Ключ             = Сообщение.Ключ;
	СтрокаПротокола.Раздел           = Сообщение.Раздел;
	СтрокаПротокола.ИмяТаблицы       = Сообщение.ИмяТаблицы;
	СтрокаПротокола.ПолноеИмяТаблицы = Сообщение.ПолноеИмяТаблицы;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьГруппуПротокола(Группа)
	
	ГруппаПротокола = Неопределено;
	
	ЭлементыПротокола = Протокол.ПолучитьЭлементы();
	Для Каждого ЭлементПротокола Из ЭлементыПротокола Цикл
		Если ЭлементПротокола.Группа = Группа Тогда
			ГруппаПротокола = ЭлементПротокола;
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	Если ГруппаПротокола = Неопределено Тогда
		ГруппаПротокола = ЭлементыПротокола.Добавить();
		ГруппаПротокола.Группа = Группа;
	КонецЕсли;
	
	Возврат ГруппаПротокола.ПолучитьЭлементы();
	
КонецФункции

